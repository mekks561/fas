# ===================================================================
# Neon Leaderboard POC 环境变量示例
# 复制本文件为 .env 并填入真实值
# ===================================================================

# Neon 数据库连接字符串
# 从 Neon 控制台获取：https://console.neon.tech
# 推荐使用 Pooled connection（连接池，适合 serverless）
# 格式：postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# 服务端口
PORT=8787

# 简易 API Key（POC 阶段，生产应替换为 JWT/Clerk Auth）
API_KEY="poc-dev-key-change-me"
